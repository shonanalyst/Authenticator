{
  "expo": {
    "name": "Authenticator",
    "slug": "Authenticator",
    "scheme": "authenticator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0F"
      },
      "minSdkVersion": 36,
      "targetSdkVersion": 54,
      "package": "com.shonanalyst.Authenticator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-web-browser"
    ]
  }
}
